  abilitySlotPrefab: {fileID: 7378478145893856102, guid: d554381bd77d6264381d21ffb2bc2bc6, type: 3}
  abilitySlotParent: {fileID: 777536524}
  tutorialSlotPrefab: {fileID: 1255104414}
  tutorials:
  - title: Move Around
    tutorialText: 'Moving is essential for you to escape Hell and make it to Paradise.


      Try
      moving in all directions'
    icon: {fileID: 985049279, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: WASD
    oneTimeHint: 0
    onlyFor: {fileID: 0}
  - title: How to Jump
    tutorialText: 'Hell consists of high places that you need to traverse


      Jumping
      allows you to climb these areas'
    icon: {fileID: 373087097, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: Space
    oneTimeHint: 0
    onlyFor: {fileID: 0}
  - title: Quick Dash
    tutorialText: 'Dashing will make you invincible during the action, it might come
      in handy both inside and outside of combat too.


      Try dashing over this
      gap'
    icon: {fileID: -855291646, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: CTRL
    oneTimeHint: 0
    onlyFor: {fileID: 0}
  - title: Run faster
    tutorialText: 'Hell is a big place and you will need to move sprint through it.


      Sprint
      through this whole corridor.'
    icon: {fileID: -1068999654, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: Hold Shift
    oneTimeHint: 0
    onlyFor: {fileID: 0}
  - title: Lock on Target
    tutorialText: 'If you do not want to lose sight of your enemy, do not turn your
      back against it.


      Try targetting the enemy infront of you.'
    icon: {fileID: -1591744204, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: Middle Mouse Button
    oneTimeHint: 0
    onlyFor: {fileID: 0}
  - title: Battle Time!
    tutorialText: 'You have to fight your way out of hell.


      Click left mouse
      button to attack.'
    icon: {fileID: 205353561, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: Left Mouse Button
    oneTimeHint: 0
    onlyFor: {fileID: 0}
  - title: Jester Whip Pull
    tutorialText: 'The whip allows you to pull smaller enemis towards you, and you
      towards bigger enemies.


      Press F to try it.'
    icon: {fileID: 21300000, guid: 63d1e4828026c744395b598ac25d7e6d, type: 3}
    keybind: F
    oneTimeHint: 0
    onlyFor: {fileID: 11400000, guid: 2ff890a3b4877a54c9850f11fbf24082, type: 2}
  - title: Jester Ground Slam
    tutorialText: 'Jester is able to perform Ground Slam.


      Attack while in
      the air to perform it.'
    icon: {fileID: 205353561, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: Right Mouse Button
    oneTimeHint: 0
    onlyFor: {fileID: 11400000, guid: 2ff890a3b4877a54c9850f11fbf24082, type: 2}
  - title: Fallen Knight Spin
    tutorialText: You can spin to do an area of effect attack.
    icon: {fileID: 21300000, guid: 63d1e4828026c744395b598ac25d7e6d, type: 3}
    keybind: F
    oneTimeHint: 0
    onlyFor: {fileID: 11400000, guid: c562244506643784c9e5b3cd80fbef25, type: 2}
  - title: Fallen Knight Block
    tutorialText: Block incoming attacks with your shield, if you time it preciously
      you can parry the enemy.
    icon: {fileID: 2067780595, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: Right Mouse Button
    oneTimeHint: 0
    onlyFor: {fileID: 11400000, guid: c562244506643784c9e5b3cd80fbef25, type: 2}
  - title: Tarot Cards
    tutorialText: Press F to draw a random card from your deck. Test your luck with
      a card draw.
    icon: {fileID: 21300000, guid: 63d1e4828026c744395b598ac25d7e6d, type: 3}
    keybind: F
    oneTimeHint: 0
    onlyFor: {fileID: 11400000, guid: dff9a6248040dd943983cf576291d589, type: 2}
  - title: Meditate
    tutorialText: Fortune Teller uses mana for her abilities, you will need to recharge
      your mana occasionally.
    icon: {fileID: -240222233, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: V
    oneTimeHint: 0
    onlyFor: {fileID: 11400000, guid: dff9a6248040dd943983cf576291d589, type: 2}
  interactionPanel: {fileID: 493611629}
  interactionText: {fileID: 2120424952}
  inventoryPanel: {fileID: 1290923794}
  deathScreen: {fileID: 0}
  restScreen: {fileID: 0}
  screenFadeTime: 1
