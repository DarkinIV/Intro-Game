--- !u!114 &1941745497
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1941745489}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f1b687081d3cd0045b37a6289c6b7d48, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  ultimateTutorials:
  - title: Untouchable
    tutorialText: "Your ultimate ability is now ready to use. It renders you invulnerable
      as every incoming attack is automatically dodged for a short duration of time.
      \n\nPress R to activate."
    icon: {fileID: -1550766814, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: R
    oneTimeHint: 1
    onlyFor: {fileID: 11400000, guid: 2ff890a3b4877a54c9850f11fbf24082, type: 2}
  - title: Unkillable
    tutorialText: 'Your ultimate ability is now ready to use. While active, you will
      not be able to go below 1 health, making you essentially unkillable for a short
      amount of time.


      Press R to activate.'
    icon: {fileID: -1550766814, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: R
    oneTimeHint: 1
    onlyFor: {fileID: 11400000, guid: c562244506643784c9e5b3cd80fbef25, type: 2}
  - title: Fate Sealed
    tutorialText: 'Your ultimate ability is now ready to use. Fate Sealed makes you
      enter a state of madness, marking every enemy in your sight and making every
      hit deal critical damage.


      Press R to activate.'
    icon: {fileID: -1550766814, guid: 6e885d1e22825fe43857fcb2f9a55455, type: 3}
    keybind: R
    oneTimeHint: 1
    onlyFor: {fileID: 11400000, guid: dff9a6248040dd943983cf576291d589, type: 2}
